rules_version = '2';

// Files of documents shared on a trip, and nothing else.
//
// The audience is in the path rather than in a Firestore lookup: storage
// rules in this project cannot read Firestore (a `firestore.get` here is
// refused even for a document that exists and matches), so everything a
// rule needs has to be visible in the path itself.
//
//   shared/{journeyId}/{ownerUid}/all/{file}       for everyone on the trip
//   shared/{journeyId}/{ownerUid}/u/{uid}/{file}   for that person, and the owner
//
// What the path cannot tell is whether someone is still on the trip, so:
//
//   - No listing. A file is reachable only through its full path, which
//     ends in the document's random id; the ids are in the Firestore
//     records, and those only current members can read. Someone removed
//     from a trip does not learn the files added after they left.
//   - No overwriting and no deleting from a client. Otherwise anyone who
//     had once been on the trip could wipe or swap a boarding pass. When a
//     record is deleted, or moves to another audience, the
//     `sharedDocumentFiles` function removes its old file; who may do that
//     is decided on the record, where the rules do check membership.
//   - Only images and PDFs, at most 20 MB: what the app itself uploads.
service firebase.storage {
  match /b/{bucket}/o {
    function isDocumentFile() {
      return request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
    }

    match /shared/{journeyId}/{ownerUid}/all/{file} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && resource == null && isDocumentFile();
      allow update, delete: if false;
    }
    match /shared/{journeyId}/{ownerUid}/u/{uid}/{file} {
      function mine() {
        return request.auth != null && (request.auth.uid == uid || request.auth.uid == ownerUid);
      }
      allow get: if mine();
      allow list: if false;
      allow create: if mine() && resource == null && isDocumentFile();
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
