# Rollout switches for functions/src/access.ts. Not secret.
#   off      no check
#   log      check and log who would be refused, refuse nobody
#   enforce  refuse
#
# Pro (RevenueCat entitlement) on the Gemini functions and the agent API.
# Needs the secret REVENUECAT_SECRET_KEY. Switch to enforce once the logs
# show no "would refuse: no Pro" for real subscribers.
ENTITLEMENT_MODE=log
# App Check on the same callables. Stays off until a build that sends App
# Check tokens is out; then log, then enforce once old builds are gone.
APP_CHECK_MODE=off
