rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each user can only read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Trips subcollection: same auth pattern
      match /trips/{tripId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Visas the user entered by hand. Same auth pattern; removed together
      // with the user document by the deleteAccount function's recursiveDelete.
      match /visas/{visaId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Planned trips, one document per journey with its stops and travellers
      // embedded. Same auth pattern. This is also what an agent reads and
      // writes on the user's behalf (through the Functions, with a token).
      match /journeys/{journeyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Accommodation plans, one document per journey stop (the document id
      // is the stop's id) with the researched options embedded. Same auth
      // pattern; an agent reaches them through the Functions, with a token.
      match /accommodations/{stopId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // AI call budget, written only by the Cloud Functions via the Admin SDK
    // (which bypasses these rules). Spelled out rather than left to the
    // catch-all below so it is obvious that clients must never touch it:
    // a user who could edit their own counter could reset their daily limit.
    match /ai_usage/{docId} {
      allow read, write: if false;
    }

    // City tips, one entry per city for everyone, written by the cityTips
    // function. Clients get them through the function, never directly.
    match /city_tips/{cityId} {
      allow read, write: if false;
    }

    // Agent tokens: hashes only, written and read by the Functions through
    // the Admin SDK. A client never touches them.
    match /agent_tokens/{tokenId} {
      allow read, write: if false;
    }

    // A trip shared with friends: the owner's journey mirrored, plus who is
    // along. Members read it, the owner's phone updates the mirror on every
    // push, and the membership itself only changes through the Functions
    // (shareJourney, joinJourney), so nobody joins without the invite code.
    match /shared_journeys/{journeyId} {
      allow read: if request.auth != null
        && (resource.data.owner_uid == request.auth.uid
          || request.auth.uid in resource.data.member_uids);
      allow update: if request.auth != null
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'legs', 'travellers', 'accommodations', 'updated_at', 'deleted', 'owner_name']);
      allow create, delete: if false;

      // Documents shared on the trip: the file is in Storage under the same
      // ids (storage.rules mirrors these checks). The owner reads them all;
      // a member reads what is for everyone or for them, and may only add
      // for everyone or for themselves. Records are the uploader's to
      // change, and the owner's.
      match /documents/{docId} {
        function trip() {
          return get(/databases/$(database)/documents/shared_journeys/$(journeyId)).data;
        }
        function isOwner() {
          return request.auth != null && trip().owner_uid == request.auth.uid;
        }
        function isMember() {
          return request.auth != null && request.auth.uid in trip().member_uids;
        }
        // The file behind a record: this trip, this owner, the folder of the
        // record's audience, the record's own id. Downloads trust this path,
        // and a member who could point it anywhere could make the others
        // fetch another trip's file.
        function pathFits(data) {
          return data.path is string && data.path.matches(
            'shared/' + journeyId + '/' + trip().owner_uid + '/'
            + (data.traveller_uid == null ? 'all' : 'u/' + data.traveller_uid)
            + '/' + docId + '([.][a-z0-9]{1,5})?');
        }
        allow read: if isOwner()
          || (isMember() && (resource.data.traveller_uid == null || resource.data.traveller_uid == request.auth.uid));
        allow create: if (isOwner() || isMember())
          && request.resource.data.uploader_uid == request.auth.uid
          && (isOwner() || request.resource.data.traveller_uid == null || request.resource.data.traveller_uid == request.auth.uid)
          && pathFits(request.resource.data);
        // Only people still on the trip: a member who was removed kept the
        // right to rewrite and delete what they had uploaded.
        allow update: if (isOwner() || (isMember() && resource.data.uploader_uid == request.auth.uid))
          && request.resource.data.uploader_uid == resource.data.uploader_uid
          && (isOwner() || request.resource.data.traveller_uid == null || request.resource.data.traveller_uid == request.auth.uid)
          && pathFits(request.resource.data);
        allow delete: if isOwner() || (isMember() && resource.data.uploader_uid == request.auth.uid);
      }
    }

    // Invite codes: read by the Functions only. A client that could list
    // them could join any trip.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
